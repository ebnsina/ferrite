# Copy to .env to move verve off these ports. Compose reads .env automatically.
# Defaults deliberately avoid the well-known ones (9000, 7233, 9090, 4317) so
# this stack does not fight another on the same machine.
COMPOSE_PROJECT_NAME=verve

VERVE_ASSETS_DB_PORT=55432
VERVE_SCHED_DB_PORT=55433
VERVE_TEMPORAL_PORT=7253
VERVE_TEMPORAL_UI_PORT=8253
VERVE_MINIO_PORT=9020
VERVE_MINIO_CONSOLE_PORT=9021
VERVE_OTLP_GRPC_PORT=4327
VERVE_OTLP_HTTP_PORT=4328
VERVE_PROMETHEUS_PORT=9092
VERVE_GRAFANA_PORT=3021

# What the code connects to. Must match the ports above.
SCHED_DATABASE_URL=postgres://verve:verve@localhost:55433/sched_db
ASSETS_DATABASE_URL=postgres://verve:verve@localhost:55432/assets_db
TEMPORAL_ADDRESS=http://localhost:7253
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4327

VERVE_S3_ENDPOINT=http://localhost:9020
VERVE_S3_BUCKET=verve-assets
VERVE_S3_REGION=us-east-1
VERVE_S3_ACCESS_KEY=verve
VERVE_S3_SECRET_KEY=verve-dev-secret
