# Copy to .env to move ferrite off these ports. Compose reads .env automatically.
# Defaults deliberately avoid the well-known ones (9000, 7233, 9090, 4317) so
# this stack does not fight another on the same machine.
COMPOSE_PROJECT_NAME=ferrite

FERRITE_ASSETS_DB_PORT=55432
FERRITE_SCHED_DB_PORT=55433
FERRITE_TEMPORAL_PORT=7253
FERRITE_TEMPORAL_UI_PORT=8253
FERRITE_MINIO_PORT=9020
FERRITE_MINIO_CONSOLE_PORT=9021
FERRITE_OTLP_GRPC_PORT=4327
FERRITE_OTLP_HTTP_PORT=4328
FERRITE_PROMETHEUS_PORT=9092
FERRITE_GRAFANA_PORT=3021

# What the code connects to. Must match the ports above.
SCHED_DATABASE_URL=postgres://ferrite:ferrite@localhost:55433/sched_db
ASSETS_DATABASE_URL=postgres://ferrite:ferrite@localhost:55432/assets_db
TEMPORAL_ADDRESS=http://localhost:7253
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4327

FERRITE_S3_ENDPOINT=http://localhost:9020
FERRITE_S3_BUCKET=ferrite-assets
FERRITE_S3_REGION=us-east-1
FERRITE_S3_ACCESS_KEY=ferrite
FERRITE_S3_SECRET_KEY=ferrite-dev-secret
